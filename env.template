# Copy to .env.

# Required. Folder holding the recordings to cut. Never modified except when you
# press "Lưu trữ" on a source, which moves it to COMPLETED_DIR/sources/.
INPUT_DIR=./input
# Required. Archive of finished matches and archived source files.
COMPLETED_DIR=./completed

# App data: session, player-name history, workspaces of matches being processed.
DATA_DIR=./data
APP_PORT=8790

# Upload privacy is chosen in the editor: Dev = private, Production = public.

# Frames sampled across a match's segments when picking the thumbnail.
CANDIDATE_THUMBNAIL_NUM=10
# Logo burned into the encoded video.
LOGO_PATH=assets/logo.png
# Hours to wait before retrying an upload after YouTube reports quota exceeded.
QUOTA_RETRY_HOURS=4
